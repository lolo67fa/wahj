<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
     Only adds the wahj:// URL scheme used to open friend invites. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ghalaalshreef.wahj.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wahj</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
